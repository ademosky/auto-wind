# ---- AUTO WIND — копирај во .env.local и пополни ги вредностите ----

# База на податоци и простор за фотографии (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # публичен клуч (безбеден за фронтенд)
SUPABASE_SERVICE_ROLE_KEY=eyJ...             # СЕКРЕТЕН клуч — само на сервер, никогаш во браузер

# Најава во admin панелот (/admin)
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=смени-ја-оваа-лозинка
ADMIN_SESSION_SECRET=долг-случаен-стринг-за-потпис-на-сесијата

# Адреса на сајтот (за SEO, sitemap и споделување)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Автоматски додадени од платформата (не ги менувај)
CODEWORDS_API_KEY=
CODEWORDS_RUNTIME_URI=

